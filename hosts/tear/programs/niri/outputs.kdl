// Desktop (tear): 1080p 165 Hz primary on DisplayPort, 1080p 60 Hz TV on HDMI.
output "DP-1" {
    mode "1920x1080@165.003"
    scale 1
    transform "normal"
    position x=0 y=0
    variable-refresh-rate
    focus-at-startup
}

output "HDMI-A-1" {
    mode "1920x1080@60.000"
    scale 1
    transform "normal"
    position x=1920 y=0
}
