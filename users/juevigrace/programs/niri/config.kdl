// Niri configuration for juevigrace.
//
// This file is installed as ~/.config/niri/config.kdl by Home Manager.
// Validate it with:
//   niri validate -c ~/.config/niri/config.kdl

input {
    keyboard {
        xkb {
            layout "us,es"
            options "grp:alt_shift_toggle"
        }

        numlock
    }

    touchpad {
        tap
        natural-scroll
    }

    mouse {
        accel-profile "flat"
    }
}

cursor {
    xcursor-theme "miku-cursor-linux"
    xcursor-size 24
}

// Monitor layout is host-specific. `outputs.kdl` is linked by Home Manager
// from hosts/<host>/programs/niri/outputs.kdl. Niri ignores output blocks for
// connectors that are not present, so a laptop and desktop can share the rest
// of this config.
include "outputs.kdl"

layout {
    // Niri has one gap value; Omarchy uses gaps_in 2 / gaps_out 4.
    gaps 4
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 1.0; }

    // Omarchy-style square windows with a 1 px accent border.
    focus-ring {
        off
    }

    border {
        on
        width 1
    }
}

// Wallpaper-derived border colours. Niri merges included sections, so this
// only overrides the two colours above. The file is generated by Skwd/Matugen;
// keep the fallback in the repo in case it has not been generated yet.
include "colors.kdl"

// Ask clients to omit client-side decorations where possible.
// Restart apps after changing this.
prefer-no-csd

// Keep the border from showing through semi-transparent windows (Ghostty).
window-rule {
    draw-border-with-background false
}

// skwd-wall restores the last wallpaper; its daemon is started by systemd.
spawn-at-startup "mako"

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

binds {
    // Show this list of hotkeys.
    Mod+Shift+Slash { show-hotkey-overlay; }

    // ── Applications (Omarchy bindings) ────────────────────────────────
    Mod+T { spawn "ghostty"; }
    Mod+Return { spawn "ghostty"; }
    Mod+Space { spawn "fuzzel"; }
    Mod+B { spawn "zen-beta"; }
    Mod+D { spawn "discord" "--no-sandbox"; }
    Mod+M { spawn "vlc"; }
    Mod+F { spawn "nautilus" "--new-window"; }
    Mod+Shift+W { spawn "skwd-wall-v2"; }
    Mod+Shift+A { spawn "ghostty" "-e" "wiremix"; }
    Super+Alt+L { spawn "swaylock-themed" "-f"; }

    Mod+Shift+C { spawn-sh "cliphist list | fuzzel --dmenu | cliphist decode | wl-copy"; }

    // ── Window management ──────────────────────────────────────────────
    Mod+C { close-window; } // Omarchy binding
    Mod+Q { close-window; } // niri default, kept as an alternate
    Mod+O repeat=false { toggle-overview; }
    Mod+Shift+F { maximize-column; } // moved from Mod+F (now file manager)
    Mod+F11 { fullscreen-window; } // Omarchy binding
    Mod+Shift+M { maximize-window-to-edges; } // moved from Mod+M (now VLC)
    Mod+V { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+W { toggle-column-tabbed-display; }

    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Down  { move-window-down; }

    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Down  { focus-monitor-down; }

    // Move the focused column (and its windows) to another monitor.
    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    // Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    // Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }

    // Move only the focused window instead of the whole column:
    // Mod+Shift+Ctrl+Alt+Left  { move-window-to-monitor-left; }
    // Mod+Shift+Ctrl+Alt+Right { move-window-to-monitor-right; }

    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }

    // Move whole workspaces up/down. This is the niri-native way to place a
    // workspace where you want it.
    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }

    // Return to the previous workspace (the quickest way back to what you
    // were just using while workspaces are dynamic).
    Mod+Tab { focus-workspace-previous; }

    // Niri workspaces are dynamic: number binds are best-effort. If the
    // number is higher than the current workspace count, niri focuses the
    // bottom empty workspace. Use Mod+Page_Up/Down or Mod+Tab when you need
    // predictable navigation.
    // To pin numbers later, declare named workspaces at the top level:
    //   workspace "1" { open-on-output "DP-1" }
    //   workspace "9" { open-on-output "HDMI-A-1" }
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 0; }

    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }
    Mod+Ctrl+0 { move-column-to-workspace 0; }

    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    // ── Screenshots and session ────────────────────────────────────────
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    Mod+Shift+P { power-off-monitors; }
    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }

    // ── Audio / media / brightness ─────────────────────────────────────
    XF86AudioRaiseVolume allow-when-locked=true {
        spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0";
    }
    XF86AudioLowerVolume allow-when-locked=true {
        spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-";
    }
    XF86AudioMute allow-when-locked=true {
        spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle";
    }
    XF86AudioMicMute allow-when-locked=true {
        spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle";
    }

    XF86AudioPlay allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext allow-when-locked=true { spawn-sh "playerctl next"; }

    XF86MonBrightnessUp allow-when-locked=true {
        spawn "brightnessctl" "--class=backlight" "set" "+10%";
    }
    XF86MonBrightnessDown allow-when-locked=true {
        spawn "brightnessctl" "--class=backlight" "set" "10%-";
    }
}
